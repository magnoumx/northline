{
  "name": "northline-newsroom",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run validate:env && cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:domain && npm run build && npm run test:rendered",
    "test:domain": "vitest run --config vitest.config.ts",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "validate:env": "node scripts/validate-environment.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler --ignore-pattern .open-next --ignore-pattern outputs --ignore-pattern backups --ignore-pattern coverage",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "admin:bootstrap": "node scripts/admin-bootstrap.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply northline-development --local",
    "db:migrate:remote": "wrangler d1 migrations apply northline-production --remote --env production",
    "db:seed": "wrangler d1 execute northline-development --local --file=scripts/seed-demo.sql",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "providers:check": "node scripts/doctor.mjs",
    "auth:check": "node scripts/doctor.mjs",
    "database:check": "node scripts/doctor.mjs",
    "infrastructure:check": "node scripts/check-infrastructure.mjs",
    "launch:check": "node scripts/doctor.mjs && node scripts/validate-environment.mjs && node scripts/check-infrastructure.mjs",
    "perf": "node scripts/lighthouse.mjs",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e": "playwright test",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "env:audit": "node scripts/env-audit.mjs",
    "db:migrate:preview": "wrangler d1 migrations apply northline-preview --remote --env preview",
    "db:migrate:production": "wrangler d1 migrations apply northline-production --remote --env production",
    "production:config": "node scripts/generate-production-config.mjs",
    "deploy:preview": "cross-env CLOUDFLARE_ENV=preview vinext deploy --env preview",
    "deploy:production": "cross-env CLOUDFLARE_ENV=production vinext deploy --env production",
    "secrets:production:bulk": "wrangler secret bulk outputs/northline-production-generated-secrets.json --env production",
    "production:check": "node scripts/production-readiness.mjs",
    "provision:cloudflare": "powershell -ExecutionPolicy Bypass -File scripts/provision-cloudflare.ps1",
    "release:verify": "npm run validate:env && npm run production:check && npm run google:check && npm run test:v11:static && npm run test:v12:static && npm run test:v12:newsroom-core && npm run test:v12:csrf-sources && npm run test:v12:ai-drafting && npm run typecheck && npm run lint && npm run test:domain && npm run build && npm run test:rendered",
    "runtime:bundle": "node scripts/prepare-runtime-secrets.mjs",
    "runtime:upload:preview": "wrangler secret bulk outputs/northline-preview-runtime.json --env preview",
    "runtime:upload:production": "wrangler secret bulk outputs/northline-production-runtime.json --env production",
    "test:v11:static": "node --test tests/v11-production-candidate.test.mjs",
    "test:v12:static": "node --test tests/v12-launch-candidate.test.mjs",
    "google:check": "node scripts/google-launch-check.mjs",
    "test:v12:newsroom-core": "node --test tests/v12-production-newsroom-core.test.mjs",
    "test:v12:csrf-sources": "node --test tests/v12-editorial-csrf-contract.test.mjs",
    "preview:finalize": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/finalize-preview-launch.ps1",
    "test:v12:ai-drafting": "node --test tests/v12-ai-research-draft.test.mjs",
    "test:v12:ai-cost-guard": "node --test tests/v12-ai-cost-guard.test.mjs",
    "test:v13:autonomous": "node --test tests/v13-autonomous-newsroom.test.mjs",
    "final:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-final-autonomous-newsroom.ps1",
    "final:launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/final-launch.ps1",
    "final:check": "node scripts/final-package-check.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.26.0",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-rsc": "^0.5.30",
    "axe-core": "^4.12.1",
    "chrome-launcher": "^1.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.11",
    "lighthouse": "^13.4.1",
    "react-server-dom-webpack": "^19.2.8",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "type": "module"
}
