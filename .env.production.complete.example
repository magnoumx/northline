# CLOUDFLARE_ACCESS (optional, protects /newsroom behind Zero Trust)
CLOUDFLARE_ACCESS_ENABLED=true
CLOUDFLARE_ACCESS_AUD=
CLOUDFLARE_ACCESS_TEAM_DOMAIN=

