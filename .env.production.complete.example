AI_REQUIRE_HUMAN_APPROVAL=true

# Northline v13 autonomous newsroom
FEATURE_AUTONOMOUS_NEWSROOM=false
AUTONOMOUS_SYSTEM_APPROVAL=false
AUTONOMOUS_DRAFT_DAILY_LIMIT=100
AUTONOMOUS_DRAFT_BATCH_SIZE=5
