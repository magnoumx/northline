RSS_FEED_ALLOWLIST=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# SEARCH_CONNECTORS
NEWS_API_KEY=
NEWS_API_BASE_URL=
SEARCH_PROVIDER=
SEARCH_ENDPOINT=
SEARCH_API_KEY=
SEARCH_CONSOLE_PROPERTY=
SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=
BING_WEBMASTER_SITE_URL=
BING_WEBMASTER_API_KEY=

# MEDIA
YOUTUBE_API_KEY=
URL_FETCH_ALLOWLIST=api.gdeltproject.org,www.youtube.com,youtube.com,youtu.be,commons.wikimedia.org,upload.wikimedia.org
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PIXELS=20000000
VIDEO_APPROVED_PROVIDER_HOSTS=www.youtube.com,youtube.com,youtu.be

# EMAIL
FEATURE_EMAIL_DELIVERY=false
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=news@YOUR_DOMAIN.com
SALES_NOTIFICATION_EMAIL=YOUR_REAL_EMAIL@example.com

# NEWSLETTER
NEWSLETTER_DOUBLE_OPT_IN=true
NEWSLETTER_CONFIRMATION_TTL_HOURS=24
NEWSLETTER_CONFIRMATION_SECRET=
NEWSLETTER_UNSUBSCRIBE_SECRET=

# ANALYTICS
