RSS_INGESTION_CRON=*/10 * * * *
AD_RECONCILIATION_CRON=0 4 * * *

# BACKUPS
FEATURE_BACKUPS=false
BACKUP_PROVIDER=r2
BACKUP_BUCKET=northline-backups
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=35
BACKUP_RPO_HOURS=24
BACKUP_RTO_HOURS=4

# FEATURE_FLAGS
FEATURE_EDITORIAL_WRITES=true
FEATURE_INTERNAL_LINKS=true
