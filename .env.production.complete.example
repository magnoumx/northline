# Northline V10 complete production environment contract
# IMPORTANT: This file contains placeholders only. Do not commit a filled copy.
# Put server-only secrets in Cloudflare Worker Secrets, not in plaintext vars.
# D1/R2/Queue resource bindings and IDs belong in wrangler.jsonc.
# Initial launch keeps indexing, auto-publishing, ads, and article audio disabled.

# APPLICATION
NODE_ENV=production
APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN.com
# Development fixtures are allowed only outside production.
DEMO_CONTENT_MODE=false
# Keep false until the audited owner launch action succeeds.
ENABLE_SEARCH_INDEXING=false
ROBOTS_ALLOW_INDEXING=false

# PUBLIC_BRAND
# Northline is a working codename pending the clearance gates in docs/v2/brand.
APP_NAME=Northline
APP_SHORT_NAME=Northline
APP_TAGLINE=Know what happened, why it matters and what comes next.
APP_LOGO=/brand/logo.svg
APP_WORDMARK=/brand/wordmark.svg
APP_FAVICON=/brand/logo.svg
APP_SOCIAL_HANDLE=@usnorthline

# DATABASE
# The Worker uses the DB binding in wrangler.jsonc. DATABASE_URL is legacy/unused.
D1_DATABASE_NAME=northline-production
DATABASE_URL=
DATABASE_BACKUP_BUCKET=northline-backups

# AUTH
# Standard signed sessions are the default. The trusted proxy adapter is only
# for an explicitly validated Sites deployment and fails closed elsewhere.
AUTH_PROVIDER=cloudflare_access
AUTH_MAGIC_LINK_ENABLED=false
AUTH_ALLOW_REGISTRATION=false
AUTH_EMAIL_FROM=news@YOUR_DOMAIN.com
AUTH_OAUTH_GOOGLE_ENABLED=false
AUTH_OAUTH_GOOGLE_CLIENT_ID=
AUTH_OAUTH_GOOGLE_CLIENT_SECRET=

# One-time owner bootstrap. Generate the token with npm run secrets:generate.
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_USERNAME=magnoumx
ADMIN_BOOTSTRAP_EMAIL=YOUR_REAL_EMAIL@example.com
ADMIN_BOOTSTRAP_TOKEN=
AUTH_MFA_ENCRYPTION_KEY=
AUTH_STAFF_MFA_REQUIRED=false
AUTH_MFA_PROVIDER=cloudflare_access

# SESSION
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_MINUTES=720
AUTH_SESSION_ROTATION_MINUTES=60
AUTH_COOKIE_NAME=northline_session

# TRUSTED_PROXY
AUTH_TRUSTED_PROXY_MODE=false
AUTH_TRUSTED_PROXY_PLATFORM=
AUTH_TRUSTED_PROXY_SECRET=
# Preview/test bootstrap only. Production authorization must come from D1 RBAC.
AUTH_ROLE_ASSIGNMENTS=

# REDIS (reserved; currently unused by the Cloudflare queue/D1 runtime)
REDIS_URL=
REDIS_TOKEN=

# QUEUE
FEATURE_DURABLE_JOBS=true
QUEUE_NAME=northline-editorial
QUEUE_DEAD_LETTER_NAME=northline-editorial-dlq
AD_EVENT_QUEUE_NAME=northline-ad-events
# Runtime queue bindings are fixed in wrangler.jsonc; these legacy names are unused.
QUEUE_BINDING=
QUEUE_DLQ_BINDING=
QUEUE_MAX_RETRIES=5
QUEUE_LEASE_SECONDS=120

# SOURCE_STORAGE
# Bucket names are declared in wrangler.jsonc bindings. Values below are metadata/public URL only.
FEATURE_OBJECT_STORAGE=true
FEATURE_SOURCE_ACQUISITION=true
R2_BUCKET=
R2_PUBLIC_BASE_URL=
SOURCE_SNAPSHOT_BUCKET=northline-media
SOURCE_FETCH_PROXY_URL=
SOURCE_FETCH_PROXY_TOKEN=

# MEDIA_STORAGE
UPLOAD_QUARANTINE_BUCKET=northline-media-quarantine
MEDIA_ASSET_BUCKET=northline-media
MALWARE_SCANNER_PROVIDER=

# ARTICLE_AUDIO
# Generated audio is fail-closed. Keep the kill switch on until an approved
# provider transport, post-processor, durable queue, and ARTICLE_AUDIO R2
# binding have passed the launch checklist. Demo mode never generates audio.
FEATURE_ARTICLE_AUDIO=false
ARTICLE_AUDIO_GLOBAL_KILL=true
ARTICLE_AUDIO_PLAYBACK_ENABLED=false
BROWSER_SPEECH_FALLBACK_ENABLED=true
ARTICLE_AUDIO_BUCKET=northline-article-audio
ARTICLE_AUDIO_R2_BINDING=ARTICLE_AUDIO
ARTICLE_AUDIO_QUEUE_NAME=northline-article-audio
ARTICLE_AUDIO_STORAGE_PREFIX=article-audio/v10
ARTICLE_AUDIO_DOWNLOAD_ALLOWED=false

# TTS_ROUTING
# Provider/model/voice IDs must be selected from the approved provider account
# and revalidated before launch; there is intentionally no production default.
TTS_PROVIDER_ORDER=google,openai,elevenlabs
TTS_OPENAI_ENABLED=false
TTS_OPENAI_MODEL=
TTS_OPENAI_VOICE=
TTS_OPENAI_USD_PER_MILLION_CHARACTERS=
TTS_GOOGLE_ENABLED=false
TTS_GOOGLE_MODEL=
TTS_GOOGLE_VOICE=
TTS_GOOGLE_USD_PER_MILLION_CHARACTERS=
GOOGLE_CLOUD_TTS_API_KEY=
TTS_ELEVENLABS_ENABLED=false
TTS_ELEVENLABS_MODEL=
TTS_ELEVENLABS_VOICE_ID=
TTS_ELEVENLABS_USD_PER_MILLION_CHARACTERS=
ELEVENLABS_API_KEY=
TTS_OUTPUT_FORMAT=MP3
TTS_CHUNK_MAX_CHARACTERS=3500
TTS_NARRATION_POLICY_VERSION=v10-initial

# TTS_BUDGETS
TTS_DAILY_BUDGET_USD=2
TTS_PER_ARTICLE_BUDGET_USD=0.50
TTS_MAX_ARTICLE_CHARACTERS=30000
# Seconds; applies to retries and explicit regenerations of the same version.
TTS_REGENERATION_COOLDOWN=3600

# AI_SAFETY
AI_ENABLED=false
AI_GLOBAL_KILL=true
AI_ALLOWED_DATA_CLASSES=public
AI_ALLOWED_FETCH_HOSTS=api.gdeltproject.org,www.googleapis.com,generativelanguage.googleapis.com,api.openai.com,api.anthropic.com

# AI_PROVIDER_KEYS (server-only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# AI_PROVIDER_RUNTIME
AI_PROVIDER_ORDER=google,openai,anthropic,local
AI_PROVIDER_TIMEOUT_MS=30000
AI_PROVIDER_RETRY_ATTEMPTS=2
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_MS=30000
AI_OPENAI_ENABLED=false
AI_OPENAI_MODEL=
AI_OPENAI_INPUT_USD_PER_MILLION_TOKENS=
AI_OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=
AI_OPENAI_CAPABILITIES=classify,summarize,extract,research_synthesis,outline,draft,fact_review,copy_review,seo_review
AI_OPENAI_TIER=paid
AI_ANTHROPIC_ENABLED=false
AI_ANTHROPIC_MODEL=
AI_ANTHROPIC_INPUT_USD_PER_MILLION_TOKENS=
AI_ANTHROPIC_OUTPUT_USD_PER_MILLION_TOKENS=
AI_ANTHROPIC_CAPABILITIES=classify,summarize,extract,research_synthesis,outline,draft,fact_review,copy_review,seo_review
AI_ANTHROPIC_TIER=paid
AI_ANTHROPIC_WEB_SEARCH_ENABLED=false
AI_ANTHROPIC_WEB_SEARCH_MAX_USES=3
AI_ANTHROPIC_WEB_SEARCH_ALLOWED_DOMAINS=
AI_ANTHROPIC_WEB_SEARCH_BLOCKED_DOMAINS=
AI_GOOGLE_ENABLED=false
AI_GOOGLE_MODEL=gemini-3.5-flash-lite
AI_GOOGLE_SEARCH_GROUNDING_ENABLED=false
AI_GOOGLE_INPUT_USD_PER_MILLION_TOKENS=0.30
AI_GOOGLE_OUTPUT_USD_PER_MILLION_TOKENS=2.50
AI_GOOGLE_CAPABILITIES=classify,summarize,extract,research_synthesis,outline,draft,fact_review,copy_review,seo_review
AI_GOOGLE_TIER=paid
AI_LOCAL_ENABLED=false
AI_LOCAL_ENDPOINT=
AI_LOCAL_API_KEY=
AI_LOCAL_MODEL=
AI_LOCAL_INPUT_USD_PER_MILLION_TOKENS=0
AI_LOCAL_OUTPUT_USD_PER_MILLION_TOKENS=0
AI_LOCAL_CAPABILITIES=classify,summarize,extract
AI_LOCAL_TIER=free

# AI_ROUTING
# Comma-separated provider:model entries. Model IDs must be supplied from an
# approved, currently verified provider account; no V4 winner is preselected.
AI_CLASSIFICATION_CHAIN=google:gemini-3.5-flash-lite
AI_EXTRACTION_CHAIN=google:gemini-3.5-flash-lite
AI_RESEARCH_CHAIN=google:gemini-3.6-flash,openai,anthropic
AI_OUTLINE_CHAIN=google:gemini-3.6-flash,openai,anthropic
AI_DRAFTING_CHAIN=google:gemini-3.6-flash,anthropic,openai
AI_FACT_REVIEW_CHAIN=openai,anthropic,google:gemini-3.6-flash
AI_COPY_EDIT_CHAIN=anthropic,openai,google:gemini-3.6-flash
AI_SEO_CHAIN=google:gemini-3.5-flash-lite,openai
AI_HEADLINE_CHAIN=google:gemini-3.5-flash-lite,openai
AI_SUMMARY_CHAIN=google:gemini-3.5-flash-lite,openai
# Legacy single-provider selectors remain as a migration fallback.
AI_CLASSIFICATION_PROVIDER=google
AI_CLASSIFICATION_MODEL=gemini-3.5-flash-lite
AI_EXTRACTION_PROVIDER=google
AI_EXTRACTION_MODEL=gemini-3.5-flash-lite
AI_RESEARCH_PROVIDER=google
AI_RESEARCH_MODEL=gemini-3.6-flash
AI_DRAFTING_PROVIDER=google
AI_DRAFTING_MODEL=gemini-3.6-flash
AI_FACT_REVIEW_PROVIDER=openai
AI_FACT_REVIEW_MODEL=
AI_COPY_EDIT_PROVIDER=anthropic
AI_COPY_EDIT_MODEL=
AI_SEO_PROVIDER=google
AI_SEO_MODEL=gemini-3.5-flash-lite
AI_ESCALATION_PROVIDER=openai
AI_ESCALATION_MODEL=
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=

# AI_BUDGETS
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=100
AI_PER_STORY_BUDGET_USD=1
AI_PER_TASK_BUDGET_USD=0.30
AI_MAX_CONTEXT_TOKENS=24000
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_REVISIONS=2
AI_MAX_CONCURRENT_JOBS=2
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_MS=30000

# AI_PROMPTS
AI_PROMPT_VERSION=v10-initial
AI_POLICY_VERSION=v10-human-publish

# TRENDS
FEATURE_TREND_CONNECTORS=true
CONNECTORS_ENABLED=true
CONNECTORS_GLOBAL_KILL=false
CONNECTOR_TIMEOUT_MS=8000
CONNECTOR_RETRY_ATTEMPTS=2
CONNECTOR_CIRCUIT_FAILURE_THRESHOLD=3
CONNECTOR_CIRCUIT_COOLDOWN_MS=30000
TREND_GDELT_ENABLED=true
TREND_GOOGLE_ENABLED=true
TREND_RSS_ENABLED=false
SEARCH_CONNECTOR_ENABLED=false
GDELT_BASE_URL=https://api.gdeltproject.org
EVENT_REGISTRY_API_KEY=
