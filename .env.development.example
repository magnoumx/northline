# Northline local development — non-secret settings only.
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEMO_CONTENT_MODE=true
ENABLE_SEARCH_INDEXING=false

APP_NAME=Northline
APP_SHORT_NAME=Northline
APP_TAGLINE=Know what happened, why it matters and what comes next.
APP_SOCIAL_HANDLE=@usnorthline
D1_DATABASE_NAME=northline-development

AUTH_PROVIDER=standard
AUTH_MAGIC_LINK_ENABLED=false
AUTH_ALLOW_REGISTRATION=false
AUTH_OAUTH_GOOGLE_ENABLED=false
AUTH_STAFF_MFA_REQUIRED=false
AUTH_SESSION_TTL_MINUTES=720
AUTH_SESSION_ROTATION_MINUTES=60
AUTH_COOKIE_NAME=northline_session

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=magnoumx
ADMIN_BOOTSTRAP_EMAIL=

CAPTCHA_PROVIDER=turnstile
CAPTCHA_REQUIRED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

AI_ENABLED=false
AI_GLOBAL_KILL=true
AI_OPENAI_ENABLED=false
AI_ANTHROPIC_ENABLED=false
AI_GOOGLE_ENABLED=false
AI_MAX_CONCURRENT_JOBS=2
AI_MAX_RETRIES=2

FEATURE_EDITORIAL_WRITES=false
FEATURE_INTERNAL_LINKS=false
FEATURE_DURABLE_JOBS=false
FEATURE_OBJECT_STORAGE=false
FEATURE_SOURCE_ACQUISITION=false
FEATURE_TREND_CONNECTORS=false
FEATURE_ARTICLE_AUDIO=false
FEATURE_EMAIL_DELIVERY=false
FEATURE_MONITORING=false
FEATURE_BACKUPS=false
FEATURE_ASK_STORY=false
FEATURE_AUTO_PUBLISH=false
FEATURE_DIRECT_ADS=false
FEATURE_ADSENSE=false
FEATURE_ADVERTISER_PORTAL=false
FEATURE_SPONSORED_CONTENT=false

CLOUDFLARE_ACCESS_ENABLED=false
AUTO_PUBLISH_READINESS_APPROVED=false
