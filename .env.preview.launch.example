# Northline V12 Preview Launch configuration.
# Public values can live in .env.preview. API keys must be uploaded with wrangler secret put.
NODE_ENV=production
APP_ENV=preview
NEXT_PUBLIC_SITE_URL=https://staging.usnorthline.com
DEMO_CONTENT_MODE=false
ENABLE_SEARCH_INDEXING=false
ROBOTS_ALLOW_INDEXING=false
GOOGLE_SEARCH_LAUNCH_APPROVED=false
SEO_MINIMUM_REAL_STORIES=20

AUTH_PROVIDER=cloudflare_access
AUTH_MAGIC_LINK_ENABLED=false
AUTH_ALLOW_REGISTRATION=false
AUTH_STAFF_MFA_REQUIRED=true
AUTH_MFA_PROVIDER=cloudflare_access
ADMIN_BOOTSTRAP_ENABLED=false
CLOUDFLARE_ACCESS_ENABLED=true
CLOUDFLARE_ACCESS_TEAM_DOMAIN=REPLACE.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=REPLACE_WITH_ACCESS_AUD

CAPTCHA_PROVIDER=turnstile
CAPTCHA_REQUIRED=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_SITE_KEY

FEATURE_EDITORIAL_WRITES=true
FEATURE_INTERNAL_LINKS=true
FEATURE_DURABLE_JOBS=true
FEATURE_OBJECT_STORAGE=true
MALWARE_SCANNER_PROVIDER=manual_review
FEATURE_SCHEDULED_INGESTION=true
FEATURE_TREND_CONNECTORS=true
CONNECTORS_ENABLED=true
CONNECTORS_GLOBAL_KILL=false
TREND_GOOGLE_ENABLED=true
TREND_GDELT_ENABLED=true
TREND_RSS_ENABLED=false
SEARCH_CONNECTOR_ENABLED=false
FEATURE_SOURCE_ACQUISITION=false

AI_ENABLED=true
AI_GLOBAL_KILL=false
AI_PROVIDER_ORDER=anthropic,google,openai
AI_ANTHROPIC_ENABLED=true
AI_ANTHROPIC_MODEL=claude-sonnet-5
AI_ANTHROPIC_INPUT_USD_PER_MILLION_TOKENS=3
AI_ANTHROPIC_OUTPUT_USD_PER_MILLION_TOKENS=15
AI_ANTHROPIC_CAPABILITIES=classify,summarize,extract,research_synthesis,outline,draft,fact_review,copy_review,seo_review
AI_ANTHROPIC_TIER=paid
AI_ANTHROPIC_WEB_SEARCH_ENABLED=true
AI_ANTHROPIC_WEB_SEARCH_MAX_USES=3
AI_ANTHROPIC_WEB_SEARCH_ALLOWED_DOMAINS=
AI_ANTHROPIC_WEB_SEARCH_BLOCKED_DOMAINS=
AI_GOOGLE_ENABLED=false
AI_OPENAI_ENABLED=false
AI_DAILY_BUDGET_USD=3
AI_MONTHLY_BUDGET_USD=30
AI_PER_STORY_BUDGET_USD=0.50
AI_PER_TASK_BUDGET_USD=0.15
AI_MAX_CONTEXT_TOKENS=24000
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_REVISIONS=2
AI_MAX_CONCURRENT_JOBS=2
AI_MAX_RETRIES=2
AI_PROVIDER_TIMEOUT_MS=30000
AI_PROVIDER_RETRY_ATTEMPTS=2
AI_PROMPT_VERSION=v12-preview
AI_POLICY_VERSION=v12-approved-only

FEATURE_AUTO_PUBLISH=true
AUTO_PUBLISH_READINESS_APPROVED=true
AUTO_PUBLISH_MODE=approved_only
AUTO_PUBLISH_DAILY_LIMIT=5
AUTO_PUBLISH_ALLOWED_CATEGORIES=TECHNOLOGY,BUSINESS,ENTERTAINMENT,SPORTS,GAMING,SCIENCE,INTERNET_TRENDS,WEATHER
AUTO_PUBLISH_ALLOWED_FORMATS=QUICK_BRIEF,STANDARD_NEWS,DEEP_EXPLAINER,WHY_TRENDING,SOURCE_COMPARISON

FEATURE_EMAIL_DELIVERY=false
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=news@send.usnorthline.com
AUTH_EMAIL_FROM=security@send.usnorthline.com
NEWSLETTER_DOUBLE_OPT_IN=true
NEWSLETTER_CONFIRMATION_TTL_HOURS=24

FEATURE_MONITORING=false
LOG_LEVEL=info
FEATURE_BACKUPS=false

AD_GLOBAL_KILL=true
FEATURE_ADSENSE=false
ADSENSE_CLIENT_ID=
GOOGLE_SITE_VERIFICATION=
DEFAULT_CONSENT_REGION=US

FEATURE_ARTICLE_AUDIO=false
ARTICLE_AUDIO_GLOBAL_KILL=true
FEATURE_DIRECT_ADS=false
FEATURE_ADVERTISER_PORTAL=false
FEATURE_GOOGLE_AD_MANAGER=false
FEATURE_SPONSORED_CONTENT=false
FEATURE_AFFILIATE_LINKS=false
FEATURE_PAID_MEMBERSHIP=false

# AI RESEARCH AND DRAFT LENGTH PROFILES
AI_QUICK_BRIEF_MIN_WORDS=400
AI_QUICK_BRIEF_TARGET_WORDS=550
AI_QUICK_BRIEF_MAX_WORDS=700
AI_STANDARD_NEWS_MIN_WORDS=900
AI_STANDARD_NEWS_TARGET_WORDS=1200
AI_STANDARD_NEWS_MAX_WORDS=1500
AI_DEEP_EXPLAINER_MIN_WORDS=1800
AI_DEEP_EXPLAINER_TARGET_WORDS=2400
AI_DEEP_EXPLAINER_MAX_WORDS=3000
AI_MIN_PRIMARY_SOURCES=1
AI_MIN_INDEPENDENT_SOURCES=2
AI_MAX_RESEARCH_SOURCES=8
AI_REQUIRE_FACT_REVIEW=true
AI_REQUIRE_HUMAN_APPROVAL=true
